<WatchFace width="450" height="450" clipShape="CIRCLE">
    <!-- Local change: hand-written face for Tsunami from the watch. BG and IOB stay visible in
         always-on. The two buttons hide there, so that a sleeve or a wet screen cannot press them
         on a dimmed display. Each is a data slot of the wear app: a tap only opens a screen, and
         insulin needs a confirmation on the screen and again from the phone. -->
    <Metadata key="CLOCK_TYPE" value="DIGITAL"/>
    <Scene backgroundColor="#ff000000">
        <DigitalClock x="125" y="28" width="200" height="72" alpha="255">
            <TimeText x="0" y="0" width="200" height="72" format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" alpha="255">
                <Font family="SYNC_TO_DEVICE" size="56" weight="NORMAL" slant="NORMAL" color="#ffe6e6e6"/>
            </TimeText>
        </DigitalClock>

        <!-- Blood glucose -->
        <ComplicationSlot slotId="0" displayName="Blood glucose" isCustomizable="TRUE" supportedTypes="SHORT_TEXT EMPTY" x="45" y="100" width="360" height="156" name="Bloodglucose_0" alpha="255">
            <DefaultProviderPolicy primaryProvider="AAPS_WEAR_APP_ID/app.aaps.wear.complications.SgvComplication" primaryProviderType="SHORT_TEXT" defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY"/>
            <BoundingBox x="0" y="0" width="360" height="156"/>
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="360" height="120" alpha="255"><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="100" weight="BOLD" slant="NORMAL" color="#ffffffff"><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Font></Text></PartText>
                <PartText x="0" y="118" width="360" height="36" alpha="255"><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="28" weight="NORMAL" slant="NORMAL" color="#ffb0bec5"><Template>%s<Parameter expression="[COMPLICATION.TITLE] != null ? [COMPLICATION.TITLE] : &quot;&quot;"/></Template></Font></Text></PartText>
            </Complication>
            <Complication type="EMPTY"/>
        </ComplicationSlot>

        <!-- Insulin on board -->
        <ComplicationSlot slotId="1" displayName="Insulin on board" isCustomizable="TRUE" supportedTypes="SHORT_TEXT EMPTY" x="105" y="262" width="240" height="50" name="Insulinonboard_1" alpha="255">
            <DefaultProviderPolicy primaryProvider="AAPS_WEAR_APP_ID/app.aaps.wear.complications.TsunamiFaceIobComplication" primaryProviderType="SHORT_TEXT" defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY"/>
            <BoundingBox x="0" y="0" width="240" height="50"/>
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="240" height="50" alpha="255"><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="38" weight="NORMAL" slant="NORMAL" color="#ff67dfe8"><Template>%s %s<Parameter expression="[COMPLICATION.TITLE] != null ? [COMPLICATION.TITLE] : &quot;&quot;"/><Parameter expression="[COMPLICATION.TEXT]"/></Template></Font></Text></PartText>
            </Complication>
            <Complication type="EMPTY"/>
        </ComplicationSlot>

        <!-- Tsunami button -->
        <ComplicationSlot slotId="2" displayName="Tsunami button" isCustomizable="TRUE" supportedTypes="SHORT_TEXT EMPTY" x="90" y="318" width="120" height="75" name="Tsunamibutton_2" alpha="255">
            <Variant mode="AMBIENT" target="alpha" value="0"/><DefaultProviderPolicy primaryProvider="AAPS_WEAR_APP_ID/app.aaps.wear.complications.TsunamiComplication" primaryProviderType="SHORT_TEXT" defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY"/>
            <BoundingBox x="0" y="0" width="120" height="75"/>
            <Complication type="SHORT_TEXT">
                <Condition>
                    <Expressions><Expression name="running"><![CDATA[[COMPLICATION.TITLE] != null]]></Expression></Expressions>
                    <Compare expression="running">
                        <PartDraw x="0" y="0" width="120" height="75" alpha="255"><RoundRectangle x="0" y="0" width="120" height="75" cornerRadiusX="24" cornerRadiusY="24"><Fill color="#ff2e7d32"/></RoundRectangle></PartDraw>
                        <PartText x="0" y="4" width="120" height="28" alpha="255"><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="22" weight="NORMAL" slant="NORMAL" color="#ffffffff"><Template>%s<Parameter expression="[COMPLICATION.TITLE]"/></Template></Font></Text></PartText>
                        <PartText x="0" y="30" width="120" height="40" alpha="255"><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="32" weight="BOLD" slant="NORMAL" color="#ffffffff"><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Font></Text></PartText>
                    </Compare>
                    <Default>
                        <PartDraw x="0" y="0" width="120" height="75" alpha="255"><RoundRectangle x="0" y="0" width="120" height="75" cornerRadiusX="24" cornerRadiusY="24"><Fill color="#ff0277bd"/></RoundRectangle></PartDraw>
                        <PartText x="0" y="18" width="120" height="40" alpha="255"><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="24" weight="BOLD" slant="NORMAL" color="#ffffffff"><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Font></Text></PartText>
                    </Default>
                </Condition>
            </Complication>
            <Complication type="EMPTY"/>
        </ComplicationSlot>

        <!-- Bolus button -->
        <ComplicationSlot slotId="3" displayName="Bolus button" isCustomizable="TRUE" supportedTypes="SHORT_TEXT EMPTY" x="240" y="318" width="120" height="75" name="Bolusbutton_3" alpha="255">
            <Variant mode="AMBIENT" target="alpha" value="0"/><DefaultProviderPolicy primaryProvider="AAPS_WEAR_APP_ID/app.aaps.wear.complications.TsunamiBolusComplication" primaryProviderType="SHORT_TEXT" defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY"/>
            <BoundingBox x="0" y="0" width="120" height="75"/>
            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="120" height="75" alpha="255"><RoundRectangle x="0" y="0" width="120" height="75" cornerRadiusX="24" cornerRadiusY="24"><Fill color="#ff37474f"/></RoundRectangle></PartDraw>
                <PartText x="0" y="18" width="120" height="40" alpha="255"><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="24" weight="BOLD" slant="NORMAL" color="#ffffffff"><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Font></Text></PartText>
            </Complication>
            <Complication type="EMPTY"/>
        </ComplicationSlot>
    </Scene>
</WatchFace>
